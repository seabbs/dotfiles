.DS_Store

# Worktrees kept inside the repo (per-task checkouts, never committed)
.worktrees/

# Python bytecode
__pycache__/
*.pyc

# Pi machine-local state (auth, sessions, trust, installed deps) at any depth
pi/**/auth.json
pi/**/trust.json
pi/**/sessions/
pi/**/node_modules/
pi/extensions/
# Pi project-local scratch dir (created wherever `pi -l` runs, including the
# repo root): ignore its contents but keep the tracked guardrails policy.
.pi/*
!.pi/extensions/
.pi/extensions/*
!.pi/extensions/guardrails.json
pi/.pi/*
!pi/.pi/extensions/
pi/.pi/extensions/*
!pi/.pi/extensions/guardrails.json

# Pi subagent run artifacts (transcripts, outputs, session logs) — machine-local.
.pi-subagents/

# Crash/debug logs dropped by CLI tools run in this repo
debug.log
