.DS_Store

# Worktrees kept inside the repo (per-task checkouts, never committed)
.worktrees/

# Python bytecode
__pycache__/
*.pyc

# Pi machine-local state (auth, sessions, trust, installed deps) at any depth
pi/**/auth.json
pi/**/trust.json
pi/**/sessions/
pi/**/node_modules/
pi/extensions/
# Pi project-local scratch dir: ignore its contents but keep the tracked
# guardrails policy.
pi/.pi/*
!pi/.pi/extensions/
pi/.pi/extensions/*
!pi/.pi/extensions/guardrails.json

# Pi subagent run artifacts (transcripts, outputs, session logs) — machine-local.
.pi-subagents/
